local function createQuickButton(text, delta)
	local button = Instance.new("TextButton")
	button.Name = "Quick_" .. text
	button.Size = UDim2.fromOffset(52, 40)
	button.BackgroundColor3 = delta >= 0 and Color3.fromRGB(38, 122, 74) or Color3.fromRGB(128, 46, 46)
	button.Font = Enum.Font.GothamBold
	button.Text = text
	button.TextColor3 = Color3.new(1, 1, 1)
	button.TextSize = 14
	button.ZIndex = 20
	button.Parent = quickButtonContainer

	local buttonCorner = Instance.new("UICorner")
	buttonCorner.CornerRadius = UDim.new(0, 10)
	buttonCorner.Parent = button

	button.MouseButton1Click:Connect(function()
		adminAdjustSpeedEvent:FireServer(delta)
	end)

	return button
end

local step = ProgressionConfig.AdminSpeedStep or 10
createQuickButton("-" .. (step * 10), -step * 10)
