local function getTypedAmount()
	local value = tonumber(amountBox.Text)
	if not value then
		return nil
	end
	return math.abs(value)
end

local function createApplyButton(text, color, sign)
	local button = Instance.new("TextButton")
	button.Name = "Apply_" .. text
	button.Size = UDim2.new(0.5, -4, 1, 0)
	button.BackgroundColor3 = color
	button.Font = Enum.Font.GothamBold
	button.Text = text
	button.TextColor3 = Color3.new(1, 1, 1)
	button.TextSize = 14
	button.ZIndex = 20
	button.Parent = applyButtonContainer

	local buttonCorner = Instance.new("UICorner")
	buttonCorner.CornerRadius = UDim.new(0, 8)
	buttonCorner.Parent = button

	button.MouseButton1Click:Connect(function()
		local amount = getTypedAmount()
		if not amount then
			amountBox.PlaceholderText = "Escribe un número válido"
			return
		end

		adminAdjustSpeedEvent:FireServer(amount * sign)
	end)

	return button
end

createApplyButton("Sumar", Color3.fromRGB(38, 122, 74), 1)
createApplyButton("Restar", Color3.fromRGB(128, 46, 46), -1)

local function bindSpeedLabel(speed)
	speedLabel.Text = string.format("Speed: %.1f", speed.Value)
	speed:GetPropertyChangedSignal("Value"):Connect(function()
		speedLabel.Text = string.format("Speed: %.1f", speed.Value)
	end)
end

local function watchLeaderstats()
	local leaderstats = localPlayer:FindFirstChild("leaderstats")
	if leaderstats then
		local speed = leaderstats:FindFirstChild("Speed")
		if speed then
			bindSpeedLabel(speed)
			return
		end
	end

	localPlayer.ChildAdded:Connect(function(child)
		if child.Name == "leaderstats" then
			local speed = child:WaitForChild("Speed")
			bindSpeedLabel(speed)
		end
	end)
end

watchLeaderstats()

