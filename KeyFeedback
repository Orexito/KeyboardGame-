local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local ProgressionConfig = require(ReplicatedStorage:WaitForChild("ProgressionConfig"))

local localPlayer = Players.LocalPlayer
local pressDepth = ProgressionConfig.KeyPressDepth or 0.6
local minimumPressTime = ProgressionConfig.MinimumKeyPressTime or 0.08
local keyDetectionPadding = ProgressionConfig.KeyDetectionPadding or 0

local pressInfo = TweenInfo.new(0.025, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

-- Curva de subida lenta y continua (sin rebote) para que, al correr muy
-- rápido y activar varias teclas seguidas, se vean varias subiendo a la
-- vez, solapándose, y formen una estela suave detrás del jugador en vez
-- de golpes secos e independientes.
local releaseInfo = TweenInfo.new(0.35, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)

local keyStates = {}
local pressedKeys = {}
local lastRootPosition = nil

-- Todo lo relacionado con la detección y animación de teclas es puramente
-- local: cada cliente comprueba su propio personaje contra las teclas que
-- tiene alrededor y anima directamente, sin pasar por el servidor. Esto
-- elimina cualquier límite de red o de consultas físicas compartidas.
local keyQueryParams = OverlapParams.new()
keyQueryParams.MaxParts = 400
keyQueryParams.FilterType = Enum.RaycastFilterType.Include
keyQueryParams.FilterDescendantsInstances = CollectionService:GetTagged("SpeedKey")

local function refreshKeyFilter()
	keyQueryParams.FilterDescendantsInstances = CollectionService:GetTagged("SpeedKey")
end

CollectionService:GetInstanceAddedSignal("SpeedKey"):Connect(refreshKeyFilter)
CollectionService:GetInstanceRemovedSignal("SpeedKey"):Connect(refreshKeyFilter)

local function getKeyState(keyPart)
	local state = keyStates[keyPart]
	if state then
		return state
	end

	state = {
		originalPosition = keyPart.Position,
		pressDepth = keyPart:GetAttribute("PressDepth") or pressDepth,
		lastSoundIndex = 0,
		pressedAt = 0,
		pressVersion = 0,
	}
	keyStates[keyPart] = state
	return state
end

local function playRandomKeySound(keyPart, state)
	local sounds = {}
	for index = 1, 3 do
		local sound = keyPart:FindFirstChild("KeySound" .. index)
		if sound and sound:IsA("Sound") then
			table.insert(sounds, sound)
		end
	end

	if #sounds == 0 then
		return
	end

	local soundIndex = math.random(1, #sounds)
	if #sounds > 1 then
		while soundIndex == state.lastSoundIndex do
			soundIndex = math.random(1, #sounds)
		end
	end

	state.lastSoundIndex = soundIndex
	local sound = sounds[soundIndex]
	sound.PlaybackSpeed = math.random(95, 105) / 100
	sound:Play()
end

local function animateKey(keyPart)
	if not keyPart:IsA("BasePart") then
		return
	end

	local state = getKeyState(keyPart)
	state.pressVersion += 1
	state.pressedAt = os.clock()
	playRandomKeySound(keyPart, state)

	TweenService:Create(keyPart, pressInfo, {
		Position = state.originalPosition - Vector3.new(0, state.pressDepth, 0),
	}):Play()
end

local function releaseKey(keyPart)
	local state = keyStates[keyPart]
	if not state or not keyPart.Parent then
		return
	end

	local pressVersion = state.pressVersion
	local remainingPressTime = minimumPressTime - (os.clock() - state.pressedAt)

	task.delay(math.max(0, remainingPressTime), function()
		if not keyPart.Parent or state.pressVersion ~= pressVersion then
			return
		end

		TweenService:Create(keyPart, releaseInfo, {
			Position = state.originalPosition,
		}):Play()
	end)
end

-- Comprueba si el segmento de movimiento del jugador (desde su posición
-- del frame anterior hasta la actual) pasa por encima de la tecla, en
-- lugar de comprobar solo el punto final. Esto evita que, a velocidades
-- altas, el personaje "atraviese" una tecla entre dos frames sin que
-- llegue a activarse.
local function isSegmentAboveKey(rootPart, startPosition, endPosition, keyPart)
	local horizontalPadding = math.max(rootPart.Size.X, rootPart.Size.Z) / 2 + keyDetectionPadding
	local halfSizeX = keyPart.Size.X / 2 + horizontalPadding
	local halfSizeZ = keyPart.Size.Z / 2 + horizontalPadding

	local travelDistance = (endPosition - startPosition).Magnitude
	local stepSize = math.max(math.min(halfSizeX, halfSizeZ), 0.5)
	local steps = math.max(1, math.ceil(travelDistance / stepSize))

	for step = 0, steps do
		local alpha = step / steps
		local samplePosition = startPosition:Lerp(endPosition, alpha)
		local localPosition = keyPart.CFrame:PointToObjectSpace(samplePosition)
		if math.abs(localPosition.X) <= halfSizeX and math.abs(localPosition.Z) <= halfSizeZ then
			return true
		end
	end

	return false
end

local function updatePressedKeys()
	local character = localPlayer.Character
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	if not rootPart then
		lastRootPosition = nil
		return
	end

	local currentPosition = rootPart.Position
	local previousPosition = lastRootPosition or currentPosition
	lastRootPosition = currentPosition

	-- Caja alineada a los ejes del mundo que envuelve el tramo recorrido
	-- este frame (más un margen), en vez de una esfera fija: así, cuanto
	-- más rápido vas, más larga es la caja y más teclas del camino se
	-- detectan, en vez de quedarse siempre en un puñado fijo.
	local margin = keyDetectionPadding + math.max(rootPart.Size.X, rootPart.Size.Z) / 2 + 3
	local minX = math.min(previousPosition.X, currentPosition.X) - margin
	local maxX = math.max(previousPosition.X, currentPosition.X) + margin
	local minZ = math.min(previousPosition.Z, currentPosition.Z) - margin
	local maxZ = math.max(previousPosition.Z, currentPosition.Z) + margin

	local boxCFrame = CFrame.new((minX + maxX) / 2, currentPosition.Y, (minZ + maxZ) / 2)
	local boxSize = Vector3.new(maxX - minX, 10, maxZ - minZ)

	local currentKeys = {}
	for _, keyPart in ipairs(workspace:GetPartBoundsInBox(boxCFrame, boxSize, keyQueryParams)) do
		if isSegmentAboveKey(rootPart, previousPosition, currentPosition, keyPart) then
			currentKeys[keyPart] = true
		end
	end

	for keyPart in pairs(pressedKeys) do
		if not currentKeys[keyPart] then
			releaseKey(keyPart)
		end
	end

	for keyPart in pairs(currentKeys) do
		if not pressedKeys[keyPart] then
			animateKey(keyPart)
		end
	end

	pressedKeys = currentKeys
end

localPlayer.CharacterAdded:Connect(function()
	pressedKeys = {}
	lastRootPosition = nil
end)

RunService.Heartbeat:Connect(updatePressedKeys)
